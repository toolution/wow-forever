---
import { Icon } from 'astro-icon/components';
import ToolPageLayout from '~/components/forever/ToolPageLayout.astro';
import { defaultLocale, locales, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { faqPageJsonLd, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { languageAlternates, localizePath } from '~/lib/url';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale) as any;
const beta = ui.forever.beta;
const pagePath = localizePath('/beta', locale);
const editionsPath = localizePath('/editions', locale);
const datesPath = localizePath('/release-date', locale);
const officialUrl = locale === 'zh'
  ? 'https://worldofwarcraft.blizzard.com/zh-cn/forever'
  : 'https://worldofwarcraft.blizzard.com/en-us/forever';
const alternates = languageAlternates((loc) => localizePath('/beta', loc), locales);
const faqItems = (ui.home.faq.items as Array<{ question: string; answer: string }>).slice(1, 3);
const jsonLd = [
  faqPageJsonLd(faqItems),
  simpleBreadcrumbJsonLd({ pageLabel: beta.title, path: pagePath, locale, homeLabel: ui.nav.home }),
];
---

<ToolPageLayout
  locale={locale}
  title={beta.metaTitle}
  description={beta.metaDescription}
  eyebrow={beta.eyebrow}
  heading={beta.title}
  lede={beta.lede}
  answerLabel={beta.answerLabel}
  answer={beta.answer}
  icon="lucide:key-round"
  jsonLd={jsonLd}
  alternates={alternates}
>
  <section class="forever-shell py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
      <form id="beta-tool" data-editions-path={editionsPath} data-dates-path={datesPath} data-official-url={officialUrl} class="rounded-lg border border-border bg-card p-5 sm:p-7">
        <div class="flex items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-muted text-nav"><Icon name="lucide:list-checks" class="h-5 w-5" /></span>
          <div>
            <h2 class="text-xl font-bold">{beta.toolTitle}</h2>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">{beta.toolDescription}</p>
          </div>
        </div>

        <fieldset class="mt-7">
          <legend class="text-sm font-semibold">{beta.ownershipQuestion}</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {beta.ownership.map((option: any, index: number) => (
              <label class="tool-choice">
                <input type="radio" name="ownership" value={option.id} checked={index === 0} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-7">
          <legend class="text-sm font-semibold">{beta.goalQuestion}</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {beta.goals.map((option: any, index: number) => (
              <label class="tool-choice">
                <input type="radio" name="goal" value={option.id} checked={index === 0} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <button type="submit" data-event="tool_complete" data-event-target="beta" class="btn-primary mt-7 min-h-11 w-full gap-2 sm:w-auto">
          <Icon name="lucide:sparkles" class="h-4 w-4" />{beta.calculate}
        </button>
      </form>

      <aside id="beta-result" class="self-start rounded-lg border border-nav/30 bg-muted p-6" aria-live="polite">
        <p class="text-xs font-semibold text-nav">{beta.resultTitle}</p>
        <h2 data-result-status class="mt-2 text-xl font-bold">{beta.results['none-chance'].status}</h2>
        <p data-result-body class="mt-3 text-sm leading-6 text-muted-foreground">{beta.results['none-chance'].body}</p>
        <a data-result-link href={officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_link_click" class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-md bg-background px-4 py-2 text-sm font-semibold text-nav shadow-sm">
          <span data-result-action>{beta.results['none-chance'].action}</span><Icon name="lucide:arrow-up-right" class="h-4 w-4" />
        </a>
      </aside>
    </div>
  </section>

  <section class="border-y border-border bg-muted/35">
    <div class="forever-shell py-12 sm:py-16">
      <h2 class="forever-display text-3xl font-bold">{beta.routesTitle}</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {beta.routes.map((route: any) => (
          <article class="rounded-lg border border-border bg-background p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-bold">{route.title}</h3>
              <span class="shrink-0 rounded-md bg-muted px-2 py-1 text-xs font-semibold text-nav">{route.badge}</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{route.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="forever-shell grid gap-10 py-12 sm:py-16 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="forever-display text-3xl font-bold">{beta.checklistTitle}</h2>
      <div id="beta-checklist" class="mt-6 space-y-2">
        {beta.checklist.map((item: string, index: number) => (
          <label class="flex min-h-12 cursor-pointer items-start gap-3 rounded-md border border-border px-4 py-3 text-sm leading-6">
            <input type="checkbox" value={String(index)} class="mt-1 h-4 w-4" />
            <span>{item}</span>
          </label>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="save-beta-checklist" type="button" data-event="checklist_save" data-event-target="beta" class="btn-outline min-h-11 gap-2"><Icon name="lucide:save" class="h-4 w-4" />{beta.save}</button>
        <span id="beta-saved" class="hidden text-sm text-nav">{beta.saved}</span>
      </div>
    </div>
    <div class="flex flex-col gap-3 lg:pt-12">
      <a href={officialUrl} target="_blank" rel="noopener noreferrer" data-event="official_link_click" class="btn-primary min-h-11 gap-2"><Icon name="lucide:external-link" class="h-4 w-4" />{beta.official}</a>
      <a href={editionsPath} class="btn-outline min-h-11 gap-2"><Icon name="lucide:package-check" class="h-4 w-4" />{beta.editions}</a>
    </div>
  </section>
</ToolPageLayout>

<script is:inline type="application/json" id="beta-results" set:html={JSON.stringify(beta.results)}></script>
<script>
  const betaForm = document.querySelector<HTMLFormElement>('#beta-tool');
  const betaResults = JSON.parse(document.querySelector('#beta-results')?.textContent || '{}');
  const betaStatus = document.querySelector<HTMLElement>('[data-result-status]');
  const betaBody = document.querySelector<HTMLElement>('[data-result-body]');
  const betaAction = document.querySelector<HTMLElement>('[data-result-action]');
  const betaLink = document.querySelector<HTMLAnchorElement>('[data-result-link]');

  betaForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(betaForm);
    const ownership = String(data.get('ownership') || 'none');
    const goal = String(data.get('goal') || 'chance');
    const key = `${ownership}-${goal}`;
    const result = betaResults[key];
    if (!result || !betaStatus || !betaBody || !betaAction || !betaLink) return;
    betaStatus.textContent = result.status;
    betaBody.textContent = result.body;
    betaAction.textContent = result.action;
    if (ownership === 'epic' || ownership === 'collection') betaLink.href = betaForm.dataset.datesPath || '/release-date/';
    else if (goal === 'included') betaLink.href = betaForm.dataset.editionsPath || '/editions/';
    else betaLink.href = betaForm.dataset.officialUrl || 'https://worldofwarcraft.blizzard.com/en-us/forever';
    if (betaLink.origin === window.location.origin) {
      betaLink.removeAttribute('target');
      betaLink.removeAttribute('rel');
    } else {
      betaLink.target = '_blank';
      betaLink.rel = 'noopener noreferrer';
    }
    document.querySelector('#beta-result')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  const betaChecklist = Array.from(document.querySelectorAll<HTMLInputElement>('#beta-checklist input'));
  try {
    const saved = JSON.parse(localStorage.getItem('forever-beta-checklist') || '[]') as string[];
    betaChecklist.forEach((input) => { input.checked = saved.includes(input.value); });
  } catch {
    // Storage can be disabled; the checklist still works for the session.
  }
  document.querySelector('#save-beta-checklist')?.addEventListener('click', () => {
    const checked = betaChecklist.filter((input) => input.checked).map((input) => input.value);
    try { localStorage.setItem('forever-beta-checklist', JSON.stringify(checked)); } catch {}
    document.querySelector('#beta-saved')?.classList.remove('hidden');
  });
</script>
