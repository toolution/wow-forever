---
import { Icon } from 'astro-icon/components';
import ToolPageLayout from '~/components/forever/ToolPageLayout.astro';
import { defaultLocale, locales, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { simpleBreadcrumbJsonLd } from '~/lib/seo';
import { languageAlternates, localizePath } from '~/lib/url';

interface Props { locale?: Locale }
const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale) as any;
const editions = ui.forever.editions;
const pagePath = localizePath('/editions', locale);
const betaPath = localizePath('/beta', locale);
const alternates = languageAlternates((loc) => localizePath('/editions', loc), locales);
const jsonLd = [simpleBreadcrumbJsonLd({ pageLabel: editions.title, path: pagePath, locale, homeLabel: ui.nav.home })];
---

<ToolPageLayout
  locale={locale}
  title={editions.metaTitle}
  description={editions.metaDescription}
  eyebrow={editions.eyebrow}
  heading={editions.title}
  lede={editions.lede}
  answerLabel={editions.answerLabel}
  answer={editions.answer}
  icon="lucide:package-check"
  jsonLd={jsonLd}
  alternates={alternates}
>
  <section class="forever-shell py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
      <form id="edition-tool" class="rounded-lg border border-border bg-card p-5 sm:p-7">
        <div class="flex items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-muted text-nav"><Icon name="lucide:sliders-horizontal" class="h-5 w-5" /></span>
          <div>
            <h2 class="text-xl font-bold">{editions.toolTitle}</h2>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">{editions.toolDescription}</p>
          </div>
        </div>

        <fieldset class="mt-7">
          <legend class="text-sm font-semibold">{editions.subscription}</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {editions.subscriptionOptions.map((option: any, index: number) => (
              <label class="tool-choice">
                <input type="radio" name="subscription" value={option.id} checked={index === 0} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-7">
          <legend class="text-sm font-semibold">{editions.needsQuestion}</legend>
          <div class="mt-3 space-y-2">
            {editions.questions.map((question: any) => (
              <label class="tool-choice">
                <input type="checkbox" name={question.id} value="yes" />
                <span>{question.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <button type="submit" data-event="tool_complete" data-event-target="editions" class="btn-primary mt-7 min-h-11 w-full gap-2 sm:w-auto">
          <Icon name="lucide:sparkles" class="h-4 w-4" />{editions.calculate}
        </button>
      </form>

      <aside id="edition-result" class="self-start rounded-lg border border-nav/30 bg-muted p-6" aria-live="polite">
        <p class="text-xs font-semibold text-nav">{editions.resultTitle}</p>
        <h2 data-edition-name class="mt-2 text-xl font-bold">{editions.results.base.name}</h2>
        <p data-edition-body class="mt-3 text-sm leading-6 text-muted-foreground">{editions.results.base.body}</p>
        <div class="mt-6 flex flex-col gap-2">
          <a href="https://shop.battle.net/product/world-of-warcraft-forever" target="_blank" rel="noopener noreferrer" data-event="official_link_click" class="btn-primary min-h-11 gap-2">
            <Icon name="lucide:external-link" class="h-4 w-4" />{editions.official}
          </a>
          <a href={betaPath} class="btn-outline min-h-11 gap-2"><Icon name="lucide:key-round" class="h-4 w-4" />{editions.beta}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-border bg-muted/35">
    <div class="forever-shell py-12 sm:py-16">
      <h2 class="forever-display text-3xl font-bold">{editions.compareTitle}</h2>
      <div class="mt-7 overflow-x-auto rounded-lg border border-border bg-background">
        <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/50">
              <th class="w-[38%] p-4 font-semibold">{locale === 'zh' ? '权益' : 'Benefit'}</th>
              {editions.columns.map((column: string) => <th class="p-4 text-center font-semibold">{column}</th>)}
            </tr>
          </thead>
          <tbody>
            {editions.rows.map((row: any) => (
              <tr class="border-b border-border last:border-b-0">
                <th class="p-4 font-medium">{row.label}</th>
                {row.values.map((value: boolean | number) => (
                  <td class="p-4 text-center">
                    {typeof value === 'number' ? (
                      <span class="font-semibold text-nav">{value}</span>
                    ) : value ? (
                      <Icon name="lucide:check" class="mx-auto h-5 w-5 text-nav" aria-label={locale === 'zh' ? '包含' : 'Included'} />
                    ) : (
                      <Icon name="lucide:minus" class="mx-auto h-5 w-5 text-muted-foreground" aria-label={locale === 'zh' ? '不包含' : 'Not included'} />
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-5 text-muted-foreground">{editions.finePrint}</p>
    </div>
  </section>

  <section class="forever-shell py-12 sm:py-16">
    <div class="grid gap-4 lg:grid-cols-3">
      {editions.packs.map((pack: any) => (
        <article class="overflow-hidden rounded-lg border border-border bg-card">
          <img src={pack.image} alt={locale === 'zh' ? `${pack.name} 礼包内容展示` : `${pack.name} pack contents`} width="960" height="540" loading="lazy" class="aspect-video w-full object-cover" />
          <div class="p-5">
            <p class="text-xs font-semibold text-nav">{pack.tag}</p>
            <h2 class="mt-2 text-xl font-bold">{pack.name}</h2>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{pack.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</ToolPageLayout>

<script is:inline type="application/json" id="edition-results" set:html={JSON.stringify(editions.results)}></script>
<script>
  const editionForm = document.querySelector<HTMLFormElement>('#edition-tool');
  const editionResults = JSON.parse(document.querySelector('#edition-results')?.textContent || '{}');
  const editionName = document.querySelector<HTMLElement>('[data-edition-name]');
  const editionBody = document.querySelector<HTMLElement>('[data-edition-body]');

  editionForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(editionForm);
    const hasSubscription = data.get('subscription') === 'yes';
    const wantsSkyborne = data.get('skyborne') === 'yes';
    const wantsBeta = data.get('beta') === 'yes';
    const wantsWarcraft = data.get('warcraft3') === 'yes';
    let key = hasSubscription ? 'base' : 'base-nosub';
    if (wantsSkyborne) key = 'heroic';
    if (wantsBeta) key = 'epic';
    if (wantsWarcraft) key = 'collection';
    const result = editionResults[key];
    if (!result || !editionName || !editionBody) return;
    editionName.textContent = result.name;
    editionBody.textContent = result.body;
    document.querySelector('#edition-result')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
