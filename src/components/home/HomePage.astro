---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import InteractionTracker from '~/components/forever/InteractionTracker.astro';
import { locales, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale) as any;
const home = ui.forever.home;
---

<LocaleLayout
  locale={locale}
  title={home.metaTitle}
  description={home.metaDescription}
  alternates={alternates}
  jsonLd={jsonLd}
  availableLocales={locales}
>
  <div data-pagefind-body>
    <section class="home-hero relative isolate overflow-hidden bg-black text-white">
      <img
        src="/images/forever/hero.webp"
        alt={home.title}
        width="1800"
        height="1100"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 -z-10 bg-black/60" aria-hidden="true"></div>
      <div class="forever-shell flex min-h-[inherit] flex-col justify-center py-16">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase text-white/80">{home.eyebrow}</p>
          <h1 class="forever-display mt-4 text-5xl font-bold leading-none text-white sm:text-6xl lg:text-7xl">{home.title}</h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">{home.lede}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={localizePath('/beta', locale)} data-event="tool_start" data-event-target="beta" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-white/90">
              <Icon name="lucide:key-round" class="h-4 w-4" />
              {home.primary}
            </a>
            <a href={localizePath('/editions', locale)} data-event="tool_start" data-event-target="editions" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-white/50 bg-black/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-black/40">
              <Icon name="lucide:package-check" class="h-4 w-4" />
              {home.secondary}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border bg-background">
      <div class="forever-shell grid divide-y divide-border py-1 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="py-5 sm:pr-6">
          <p class="text-xs text-muted-foreground">{home.status}</p>
          <p class="mt-1 font-semibold">{home.statusValue}</p>
          <p class="mt-1 text-xs text-muted-foreground">{home.statusNote}</p>
        </div>
        <div class="py-5 sm:px-6">
          <p class="text-xs text-muted-foreground">{home.launch}</p>
          <p class="mt-1 font-semibold">{home.launchValue}</p>
        </div>
        <div class="py-5 sm:pl-6">
          <p class="text-xs text-muted-foreground">{home.access}</p>
          <p class="mt-1 font-semibold">{home.accessValue}</p>
        </div>
      </div>
    </section>

    <section class="forever-shell py-14 sm:py-18">
      <h2 class="forever-display text-3xl font-bold">{home.tasksTitle}</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {home.tasks.map((task: any) => (
          <a href={task.href.startsWith('#') ? task.href : localizePath(task.href, locale)} class="group flex min-h-56 flex-col rounded-lg border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-nav/50 hover:shadow-lg">
            <span class="grid h-10 w-10 place-items-center rounded-md bg-muted text-nav">
              <Icon name={task.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold">{task.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-6 text-muted-foreground">{task.description}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-nav">
              {task.action}<Icon name="lucide:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="border-y border-border bg-muted/35">
      <div class="forever-shell py-14 sm:py-18">
        <p class="forever-kicker">{home.confusionEyebrow}</p>
        <h2 class="forever-display mt-2 max-w-2xl text-3xl font-bold">{home.confusionTitle}</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-3">
          {home.facts.map((fact: any) => (
            <div class="border-l-2 border-nav pl-5">
              <Icon name={fact.icon} class="h-5 w-5 text-nav" />
              <h3 class="mt-4 font-bold">{fact.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{fact.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="returning" class="scroll-mt-24 border-b border-border">
      <div class="grid lg:grid-cols-2">
        <div class="min-h-80 lg:min-h-[34rem]">
          <img src="/images/forever/overview.webp" alt={home.returningTitle} width="1400" height="788" loading="lazy" class="h-full w-full object-cover" />
        </div>
        <div class="flex items-center bg-background px-5 py-12 sm:px-10 lg:px-14">
          <div class="max-w-xl">
            <p class="forever-kicker">{home.returningEyebrow}</p>
            <h2 class="forever-display mt-2 text-3xl font-bold sm:text-4xl">{home.returningTitle}</h2>
            <p class="mt-5 text-base leading-7 text-muted-foreground">{home.returningBody}</p>
            <div class="mt-8 divide-y divide-border border-y border-border">
              {home.versions.map((version: any) => (
                <div class="grid gap-1 py-4 sm:grid-cols-[6rem_1fr] sm:gap-4">
                  <p class="font-bold text-nav">{version.name}</p>
                  <div>
                    <p class="text-sm font-semibold">{version.label}</p>
                    <p class="mt-1 text-sm leading-6 text-muted-foreground">{version.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="forever-shell grid gap-10 py-14 sm:py-18 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="forever-kicker">{home.launch}</p>
        <h2 class="forever-display mt-2 text-3xl font-bold">{home.timelineTitle}</h2>
      </div>
      <ol class="divide-y divide-border border-y border-border">
        {home.timeline.map((event: any, index: number) => (
          <li class="grid gap-3 py-5 sm:grid-cols-[7rem_1fr]">
            <div class="flex items-center gap-2 text-sm font-semibold text-nav">
              <span class="grid h-6 w-6 place-items-center rounded-full border border-nav/40 text-xs">{index + 1}</span>
              <span>{event.date}</span>
            </div>
            <div>
              <h3 class="font-bold">{event.title}</h3>
              <p class="mt-1 text-sm leading-6 text-muted-foreground">{event.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-t border-border bg-foreground text-background">
      <div class="forever-shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="forever-display text-2xl font-bold">{home.closingTitle}</h2>
          <p class="mt-2 text-sm text-background/70">{home.closingBody}</p>
        </div>
        <a href={localizePath('/beta', locale)} class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-md bg-background px-5 py-3 text-sm font-semibold text-foreground">
          <Icon name="lucide:key-round" class="h-4 w-4" />{home.closingAction}
        </a>
      </div>
    </section>
  </div>
  <InteractionTracker />
</LocaleLayout>

<style>
  .home-hero {
    min-height: clamp(34rem, calc(100svh - 8rem), 46rem);
  }
</style>
