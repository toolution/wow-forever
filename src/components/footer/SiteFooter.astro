---
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = getUi(locale) as any;
const footer = ui.footer as Record<string, string>;
const forever = ui.forever;
const legalLinks = [
  ['about', footer.about],
  ['privacy-policy', footer.privacyPolicy],
  ['terms-of-service', footer.termsOfService],
  ['copyright', footer.copyright],
  ['contact', footer.contact],
];
---

<footer class="border-t border-border bg-muted/40">
  <div class="forever-shell grid gap-8 py-10 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2 font-bold">
        <img src="/logo-mark.svg" alt="" width="28" height="28" class="h-7 w-7" />
        <span>{site.name}</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-6 text-muted-foreground">{site.tagline}</p>
      <p class="mt-3 text-xs text-muted-foreground">{forever.verified}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold">{footer.community}</h2>
      <a
        href={site.social.official}
        target="_blank"
        rel="noopener noreferrer"
        data-event="official_link_click"
        class="mt-3 inline-flex items-center gap-2 text-sm text-foreground/80 transition hover:text-nav"
      >
        <Icon name="lucide:external-link" class="h-4 w-4" />
        {footer.playGame}
      </a>
    </div>

    <div>
      <h2 class="text-sm font-semibold">{footer.legal}</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-1">
        {legalLinks.map(([path, label]) => (
          <li><a href={localizePath(`/${path}`, locale)} class="text-sm text-foreground/70 transition hover:text-nav">{label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="forever-shell space-y-1 py-5 text-xs text-muted-foreground">
      <p>{footer.copyrightText}</p>
      <p>{site.legalNotice}</p>
    </div>
  </div>
</footer>
