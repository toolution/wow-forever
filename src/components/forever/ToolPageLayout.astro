---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import InteractionTracker from './InteractionTracker.astro';
import { locales, type Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
  answerLabel: string;
  answer: string;
  icon: string;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, title, description, eyebrow, heading, lede, answerLabel, answer, icon, jsonLd = [], alternates = [] } = Astro.props;
---

<LocaleLayout locale={locale} title={title} description={description} jsonLd={jsonLd} alternates={alternates} availableLocales={locales}>
  <article data-pagefind-body>
    <header class="border-b border-border bg-muted/35">
      <div class="forever-shell grid gap-8 py-12 md:grid-cols-[1fr_auto] md:items-end md:py-16">
        <div class="max-w-3xl">
          <p class="forever-kicker">{eyebrow}</p>
          <h1 class="forever-display mt-3 text-4xl font-bold leading-tight text-foreground sm:text-5xl">{heading}</h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">{lede}</p>
        </div>
        <div class="grid h-20 w-20 place-items-center rounded-md border border-nav/30 bg-background" aria-hidden="true">
          <Icon name={icon} class="h-9 w-9 text-nav" />
        </div>
      </div>
    </header>

    <section class="border-b border-border bg-background">
      <div class="forever-shell flex gap-4 py-6">
        <Icon name="lucide:badge-check" class="mt-0.5 h-5 w-5 shrink-0 text-nav" />
        <div>
          <p class="text-xs font-semibold text-nav">{answerLabel}</p>
          <p class="mt-1 max-w-4xl text-sm leading-6 text-foreground sm:text-base">{answer}</p>
        </div>
      </div>
    </section>

    <slot />
  </article>
  <InteractionTracker />
</LocaleLayout>
