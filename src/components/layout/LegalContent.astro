---
import { getUi } from '~/i18n/ui';
import { officialForeverUrl, type Locale } from '~/i18n/routing';

type LegalPageKey = 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';

interface Props {
  page: LegalPageKey;
  locale?: Locale;
}

interface LegalSection {
  title: string;
  body?: string;
  items?: string[];
  officialLink?: string;
}

interface LegalCopy {
  title: string;
  intro: string;
  sections: LegalSection[];
}

const { page, locale = 'zh' } = Astro.props;
const ui = getUi(locale) as any;
const copy = ui.legal[page] as LegalCopy;
const officialUrl = officialForeverUrl(locale);
---

<p>{copy.intro}</p>
{copy.sections.map((section) => (
  <>
    <h2>{section.title}</h2>
    {section.body && <p>{section.body}</p>}
    {section.items && (
      <ul>
        {section.items.map((item) => <li>{item}</li>)}
      </ul>
    )}
    {section.officialLink && (
      <p>
        <a href={officialUrl} target="_blank" rel="noopener noreferrer">
          {section.officialLink}
        </a>
      </p>
    )}
  </>
))}
