---
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, localizePath, switchLocalePath } from '~/lib/url';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  currentPath: string;
  availableLocales?: readonly Locale[];
}

const { locale, currentPath, availableLocales } = Astro.props;
const ui = getUi(locale) as any;
const forever = ui.forever;
const nav = forever.nav as Array<{ label: string; href: string; icon: string }>;
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const localizedNav = nav.map((item) => ({ ...item, href: localizePath(item.href, locale) }));
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href={homeUrl(locale)} class="flex min-w-0 items-center gap-2.5 text-foreground" aria-label={site.name}>
      <span class="grid h-10 w-10 shrink-0 place-items-center">
        <img src="/logo-mark.svg" alt="" width="40" height="40" class="h-10 w-10" />
      </span>
      <span class="min-w-0">
        <span class="forever-display block truncate text-lg font-bold leading-none">{site.shortName}</span>
        <span class="mt-1 hidden text-[11px] leading-none text-muted-foreground sm:block">{forever.brandLabel}</span>
      </span>
    </a>

    <nav class="ml-4 hidden flex-1 items-center justify-center gap-1 md:flex" aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}>
      {localizedNav.map((item) => {
        const active = normalizedPath === item.href;
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'inline-flex h-10 items-center gap-2 rounded-md px-3 text-sm font-medium transition',
              active ? 'bg-muted text-nav' : 'text-foreground/70 hover:bg-muted hover:text-foreground',
            ]}
          >
            <Icon name={item.icon} class="h-4 w-4" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <span class="mr-2 hidden text-xs text-muted-foreground lg:block">{forever.verified}</span>
      <LanguageSwitcher
        locale={locale}
        availableLocales={availableLocales}
        pathFor={(targetLocale) => switchLocalePath(currentPath, targetLocale)}
      />
      <ThemeToggle />
      <details class="relative md:hidden">
        <summary
          class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition hover:bg-muted"
          aria-label={(ui.nav as Record<string, string>).menu}
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <nav class="absolute right-0 mt-2 w-64 overflow-hidden rounded-md border border-border bg-card p-2 shadow-xl" aria-label={locale === 'zh' ? '移动端导航' : 'Mobile navigation'}>
          {localizedNav.map((item) => (
            <a
              href={item.href}
              class="flex min-h-11 items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition hover:bg-muted"
            >
              <Icon name={item.icon} class="h-4 w-4 text-nav" />
              <span>{item.label}</span>
            </a>
          ))}
          <p class="border-t border-border px-3 pt-3 text-xs text-muted-foreground">{forever.verified}</p>
        </nav>
      </details>
    </div>
  </div>
</header>
