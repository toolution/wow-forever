---
/**
 * Language switcher — a dropdown built with native <details> (zero JS).
 * Renders the current locale and links to the same page in other locales.
 */
import { Icon } from 'astro-icon/components';
import { locales, LOCALE_LABELS, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { LOCALE_STORAGE_KEY } from '~/lib/browser-locale';

interface Props {
  locale: Locale;
  /** Function that returns the path for a given locale (same page, different lang). */
  pathFor: (locale: Locale) => string;
  /**
   * Locales this page actually exists in (optional). Tag pages don't fall
   * back to English, so they pass their real coverage — a locale without
   * the tag is omitted instead of linking to a 404.
   */
  availableLocales?: readonly Locale[];
}
const { locale, pathFor, availableLocales } = Astro.props as Props;
const switchLocales = availableLocales ?? locales;
const languageLabel = (getUi(locale).nav as Record<string, string>).language;
---

<details class="relative">
  <summary
    aria-label={languageLabel}
    class="inline-flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-foreground transition hover:bg-muted"
  >
    <Icon name="lucide:globe" class="h-4 w-4" />
    <span class="hidden max-w-40 truncate sm:inline">{LOCALE_LABELS[locale]}</span>
    <Icon name="lucide:chevron-down" class="hidden h-3 w-3 sm:inline-flex" />
  </summary>
  <div class="absolute right-0 z-50 mt-2 w-52 overflow-hidden rounded-md border bg-card shadow-lg">
    {
      switchLocales.map((loc) => (
        <a
          href={pathFor(loc)}
          data-forever-locale={loc}
          class:list={[
            'block px-3 py-2 text-sm transition hover:bg-muted',
            loc === locale && 'font-semibold text-nav',
          ]}
        >
          {LOCALE_LABELS[loc]}
        </a>
      ))
    }
  </div>
</details>

<script is:inline define:vars={{ localeStorageKey: LOCALE_STORAGE_KEY }}>
  (() => {
    if (document.documentElement.dataset.foreverLocaleListener === 'true') return;
    document.documentElement.dataset.foreverLocaleListener = 'true';

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a[data-forever-locale]');
      const selectedLocale = link?.getAttribute('data-forever-locale');
      if (!selectedLocale) return;

      try {
        localStorage.setItem(localeStorageKey, selectedLocale);
      } catch {
        /* Navigation still works when storage is unavailable. */
      }
    });
  })();
</script>
